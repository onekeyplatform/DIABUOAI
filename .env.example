# Global runtime
NODE_ENV=development
APP_NAME=DIABUOAI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Postgres
POSTGRES_DB=diabuoai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diabuoai?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-me-with-a-secure-secret
JWT_EXPIRES_IN=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# OpenAI and AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGGRAPH_API_URL=http://localhost:8080

# Monitoring
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email/SMS/WhatsApp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_API_TOKEN=

# Vector / RAG
VECTOR_PROVIDER=pgvector
EMBEDDING_MODEL=text-embedding-3-small

# Logging
LOG_LEVEL=info
